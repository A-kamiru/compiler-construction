        printf("The sum is large", sum);
    } else {
        printf("The sum is small", sum);
    }

    int counter = 0;
    while (counter != 3) {
        counter = counter + 1;
    }

    for (x = 0; x < 5; x = x + 1) {
        y = y / 2;
    }

    return 0;
}